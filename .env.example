VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Cloudflare R2 credentials. Never prefix these with VITE_.
CLOUDFLARE_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=yvimo-course-videos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MAX_VIDEO_BYTES=2147483648
VITE_GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
# Optional. If empty, Google Maps uses DEMO_MAP_ID for Advanced Markers in local/dev.
VITE_GOOGLE_MAPS_MAP_ID=
# Optional fallback for the legacy in-memory Suppliers demo.
VITE_SUPPLIERS_DEMO_MODE=false
